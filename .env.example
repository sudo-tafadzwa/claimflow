# Copy to .env. Everything has a working demo default; nothing here is needed to run the demo.

# fake = deterministic rule-based extractor (no API key). anthropic = Claude.
EXTRACTION_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Payouts above this are rejected by the mock ledger, which triggers compensation (try 5000 in the demo).
LEDGER_REJECT_ABOVE=50000

DB_PASSWORD=claimflow
KEYCLOAK_ADMIN_PASSWORD=admin
