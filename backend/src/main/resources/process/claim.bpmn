<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Claim"
                  targetNamespace="https://claimflow.dev/bpmn"
                  exporter="hand-written"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.8.0">

  <bpmn:message id="Msg_TaskCompleted" name="task-completed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=currentTaskId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Err_LedgerRejected" name="Ledger rejected" errorCode="LEDGER_REJECTED" />

  <bpmn:process id="claim" name="Insurance claim" isExecutable="true">

    <bpmn:startEvent id="Start_ClaimSubmitted" name="Claim submitted">
      <bpmn:outgoing>F_Start_Extract</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. AI extraction -->
    <bpmn:serviceTask id="Task_ExtractFields" name="Extract claim fields (AI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.extract-fields" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Start_Extract</bpmn:incoming>
      <bpmn:outgoing>F_Extract_Confidence</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Confidence" name="All fields confident?" default="F_Confidence_Ok">
      <bpmn:incoming>F_Extract_Confidence</bpmn:incoming>
      <bpmn:outgoing>F_Confidence_Low</bpmn:outgoing>
      <bpmn:outgoing>F_Confidence_Ok</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_OpenVerify" name="Open verification task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.open" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="taskType" value="VERIFY_FIELDS" />
          <zeebe:header key="candidateRole" value="adjuster" />
          <zeebe:header key="slaHours" value="8" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Confidence_Low</bpmn:incoming>
      <bpmn:outgoing>F_OpenVerify_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:receiveTask id="Wait_Verify" name="Adjuster verifies fields" messageRef="Msg_TaskCompleted">
      <bpmn:incoming>F_OpenVerify_Wait</bpmn:incoming>
      <bpmn:outgoing>F_Verify_Merge</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:boundaryEvent id="Timer_VerifySla" name="8h SLA" cancelActivity="false" attachedToRef="Wait_Verify">
      <bpmn:outgoing>F_VerifySla_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_timerEventDefinition_1">
        <bpmn:timeDuration>PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_EscalateVerify" name="Escalate verification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.escalate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_VerifySla_Escalate</bpmn:incoming>
      <bpmn:outgoing>F_EscalateVerify_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_VerifyEscalated" name="Escalated">
      <bpmn:incoming>F_EscalateVerify_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gw_MergeVerify">
      <bpmn:incoming>F_Confidence_Ok</bpmn:incoming>
      <bpmn:incoming>F_Verify_Merge</bpmn:incoming>
      <bpmn:outgoing>F_Merge_Policy</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 2. Policy and rules -->
    <bpmn:serviceTask id="Task_LookupPolicy" name="Look up policy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="policy.lookup" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Merge_Policy</bpmn:incoming>
      <bpmn:outgoing>F_Policy_Coverage</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_Coverage" name="Decide coverage">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="coverage" resultVariable="coverage" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Policy_Coverage</bpmn:incoming>
      <bpmn:outgoing>F_Coverage_Gw</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gw_Covered" name="Covered?" default="F_Covered_Yes">
      <bpmn:incoming>F_Coverage_Gw</bpmn:incoming>
      <bpmn:outgoing>F_Covered_No</bpmn:outgoing>
      <bpmn:outgoing>F_Covered_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_FraudScore" name="Score fraud risk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.fraud-score" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Covered_Yes</bpmn:incoming>
      <bpmn:outgoing>F_Fraud_Gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_AutoApprove" name="Auto-approve?" default="F_Auto_No">
      <bpmn:incoming>F_Fraud_Gw</bpmn:incoming>
      <bpmn:outgoing>F_Auto_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_Auto_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 3. Adjuster review -->
    <bpmn:serviceTask id="Task_OpenReview" name="Open adjuster review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.open" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=if coverage.payableAmount &gt; 5000 then &quot;senior-adjuster&quot; else &quot;adjuster&quot;" target="candidateRole" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="taskType" value="ADJUSTER_REVIEW" />
          <zeebe:header key="slaHours" value="48" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Auto_No</bpmn:incoming>
      <bpmn:outgoing>F_OpenReview_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:receiveTask id="Wait_Review" name="Adjuster decides" messageRef="Msg_TaskCompleted">
      <bpmn:incoming>F_OpenReview_Wait</bpmn:incoming>
      <bpmn:outgoing>F_Review_Gw</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:boundaryEvent id="Timer_ReviewSla" name="48h SLA" cancelActivity="false" attachedToRef="Wait_Review">
      <bpmn:outgoing>F_ReviewSla_Escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_timerEventDefinition_2">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_EscalateReview" name="Escalate review">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.escalate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_ReviewSla_Escalate</bpmn:incoming>
      <bpmn:outgoing>F_EscalateReview_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_ReviewEscalated" name="Escalated">
      <bpmn:incoming>F_EscalateReview_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gw_Decision" name="Approved?" default="F_Decision_Reject">
      <bpmn:incoming>F_Review_Gw</bpmn:incoming>
      <bpmn:outgoing>F_Decision_Approve</bpmn:outgoing>
      <bpmn:outgoing>F_Decision_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_MergeApproved">
      <bpmn:incoming>F_Auto_Yes</bpmn:incoming>
      <bpmn:incoming>F_Decision_Approve</bpmn:incoming>
      <bpmn:outgoing>F_Approved_Prepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4. Payout with maker-checker -->
    <bpmn:serviceTask id="Task_OpenPrepare" name="Open payout preparation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.open" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="taskType" value="PAYOUT_PREPARE" />
          <zeebe:header key="candidateRole" value="finance-maker" />
          <zeebe:header key="slaHours" value="24" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Approved_Prepare</bpmn:incoming>
      <bpmn:outgoing>F_OpenPrepare_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:receiveTask id="Wait_Prepare" name="Finance maker prepares payout" messageRef="Msg_TaskCompleted">
      <bpmn:incoming>F_OpenPrepare_Wait</bpmn:incoming>
      <bpmn:outgoing>F_Prepare_Release</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:serviceTask id="Task_OpenRelease" name="Open payout release">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="task.open" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="taskType" value="PAYOUT_RELEASE" />
          <zeebe:header key="candidateRole" value="finance-checker" />
          <zeebe:header key="slaHours" value="24" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Prepare_Release</bpmn:incoming>
      <bpmn:outgoing>F_OpenRelease_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:receiveTask id="Wait_Release" name="Finance checker releases payout" messageRef="Msg_TaskCompleted">
      <bpmn:incoming>F_OpenRelease_Wait</bpmn:incoming>
      <bpmn:outgoing>F_Release_Pay</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:serviceTask id="Task_ExecutePayout" name="Execute payout">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.execute" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Release_Pay</bpmn:incoming>
      <bpmn:outgoing>F_Pay_Ledger</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Comp_Payout" attachedToRef="Task_ExecutePayout">
      <bpmn:compensateEventDefinition id="Def_compensateEventDefinition_3" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_ReversePayout" name="Reverse payout" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.reverse" retries="5" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_PostLedger" name="Post to ledger">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ledger.post" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Pay_Ledger</bpmn:incoming>
      <bpmn:outgoing>F_Ledger_NotifyPaid</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Err_Ledger" name="Ledger rejected" attachedToRef="Task_PostLedger">
      <bpmn:outgoing>F_LedgerErr_Compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Def_errorEventDefinition_4" errorRef="Err_LedgerRejected" />
    </bpmn:boundaryEvent>

    <bpmn:intermediateThrowEvent id="Throw_Compensate" name="Reverse payout">
      <bpmn:incoming>F_LedgerErr_Compensate</bpmn:incoming>
      <bpmn:outgoing>F_Compensated_Notify</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Def_compensateEventDefinition_5" />
    </bpmn:intermediateThrowEvent>

    <!-- 5. Outcomes -->
    <bpmn:serviceTask id="Task_NotifyPaid" name="Notify: paid">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="outcome" value="PAID" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Ledger_NotifyPaid</bpmn:incoming>
      <bpmn:outgoing>F_NotifyPaid_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Paid" name="Claim paid">
      <bpmn:incoming>F_NotifyPaid_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_NotifyReversed" name="Notify: payout reversed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="outcome" value="PAYOUT_REVERSED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Compensated_Notify</bpmn:incoming>
      <bpmn:outgoing>F_NotifyReversed_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_PayoutReversed" name="Payout reversed">
      <bpmn:incoming>F_NotifyReversed_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gw_MergeRejected">
      <bpmn:incoming>F_Covered_No</bpmn:incoming>
      <bpmn:incoming>F_Decision_Reject</bpmn:incoming>
      <bpmn:outgoing>F_Rejected_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_NotifyRejected" name="Notify: rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="claim.notify" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="outcome" value="REJECTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Rejected_Notify</bpmn:incoming>
      <bpmn:outgoing>F_NotifyRejected_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Rejected" name="Claim rejected">
      <bpmn:incoming>F_NotifyRejected_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="F_Start_Extract" sourceRef="Start_ClaimSubmitted" targetRef="Task_ExtractFields" />
    <bpmn:sequenceFlow id="F_Extract_Confidence" sourceRef="Task_ExtractFields" targetRef="Gw_Confidence" />
    <bpmn:sequenceFlow id="F_Confidence_Low" name="no" sourceRef="Gw_Confidence" targetRef="Task_OpenVerify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=lowConfidence = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Confidence_Ok" name="yes" sourceRef="Gw_Confidence" targetRef="Gw_MergeVerify" />
    <bpmn:sequenceFlow id="F_OpenVerify_Wait" sourceRef="Task_OpenVerify" targetRef="Wait_Verify" />
    <bpmn:sequenceFlow id="F_Verify_Merge" sourceRef="Wait_Verify" targetRef="Gw_MergeVerify" />
    <bpmn:sequenceFlow id="F_VerifySla_Escalate" sourceRef="Timer_VerifySla" targetRef="Task_EscalateVerify" />
    <bpmn:sequenceFlow id="F_EscalateVerify_End" sourceRef="Task_EscalateVerify" targetRef="End_VerifyEscalated" />
    <bpmn:sequenceFlow id="F_Merge_Policy" sourceRef="Gw_MergeVerify" targetRef="Task_LookupPolicy" />
    <bpmn:sequenceFlow id="F_Policy_Coverage" sourceRef="Task_LookupPolicy" targetRef="Task_Coverage" />
    <bpmn:sequenceFlow id="F_Coverage_Gw" sourceRef="Task_Coverage" targetRef="Gw_Covered" />
    <bpmn:sequenceFlow id="F_Covered_No" name="no" sourceRef="Gw_Covered" targetRef="Gw_MergeRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=coverage.covered = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Covered_Yes" name="yes" sourceRef="Gw_Covered" targetRef="Task_FraudScore" />
    <bpmn:sequenceFlow id="F_Fraud_Gw" sourceRef="Task_FraudScore" targetRef="Gw_AutoApprove" />
    <bpmn:sequenceFlow id="F_Auto_Yes" name="yes" sourceRef="Gw_AutoApprove" targetRef="Gw_MergeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=coverage.autoApproveEligible = true and fraudScore &lt; 0.3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Auto_No" name="no" sourceRef="Gw_AutoApprove" targetRef="Task_OpenReview" />
    <bpmn:sequenceFlow id="F_OpenReview_Wait" sourceRef="Task_OpenReview" targetRef="Wait_Review" />
    <bpmn:sequenceFlow id="F_Review_Gw" sourceRef="Wait_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F_ReviewSla_Escalate" sourceRef="Timer_ReviewSla" targetRef="Task_EscalateReview" />
    <bpmn:sequenceFlow id="F_EscalateReview_End" sourceRef="Task_EscalateReview" targetRef="End_ReviewEscalated" />
    <bpmn:sequenceFlow id="F_Decision_Approve" name="approve" sourceRef="Gw_Decision" targetRef="Gw_MergeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=decision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Decision_Reject" name="reject" sourceRef="Gw_Decision" targetRef="Gw_MergeRejected" />
    <bpmn:sequenceFlow id="F_Approved_Prepare" sourceRef="Gw_MergeApproved" targetRef="Task_OpenPrepare" />
    <bpmn:sequenceFlow id="F_OpenPrepare_Wait" sourceRef="Task_OpenPrepare" targetRef="Wait_Prepare" />
    <bpmn:sequenceFlow id="F_Prepare_Release" sourceRef="Wait_Prepare" targetRef="Task_OpenRelease" />
    <bpmn:sequenceFlow id="F_OpenRelease_Wait" sourceRef="Task_OpenRelease" targetRef="Wait_Release" />
    <bpmn:sequenceFlow id="F_Release_Pay" sourceRef="Wait_Release" targetRef="Task_ExecutePayout" />
    <bpmn:sequenceFlow id="F_Pay_Ledger" sourceRef="Task_ExecutePayout" targetRef="Task_PostLedger" />
    <bpmn:sequenceFlow id="F_Ledger_NotifyPaid" sourceRef="Task_PostLedger" targetRef="Task_NotifyPaid" />
    <bpmn:sequenceFlow id="F_NotifyPaid_End" sourceRef="Task_NotifyPaid" targetRef="End_Paid" />
    <bpmn:sequenceFlow id="F_LedgerErr_Compensate" sourceRef="Err_Ledger" targetRef="Throw_Compensate" />
    <bpmn:sequenceFlow id="F_Compensated_Notify" sourceRef="Throw_Compensate" targetRef="Task_NotifyReversed" />
    <bpmn:sequenceFlow id="F_NotifyReversed_End" sourceRef="Task_NotifyReversed" targetRef="End_PayoutReversed" />
    <bpmn:sequenceFlow id="F_Rejected_Notify" sourceRef="Gw_MergeRejected" targetRef="Task_NotifyRejected" />
    <bpmn:sequenceFlow id="F_NotifyRejected_End" sourceRef="Task_NotifyRejected" targetRef="End_Rejected" />

    <bpmn:association id="Assoc_Compensation" associationDirection="One" sourceRef="Comp_Payout" targetRef="Task_ReversePayout" />
  </bpmn:process>
</bpmn:definitions>
